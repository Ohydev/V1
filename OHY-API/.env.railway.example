# Reference for the variables to set on the OHY-API service in Railway's
# dashboard (Variables tab) — NOT a file the app reads. Unlike .env.example
# this documents production values, not local-dev defaults.

APP_NAME="OHY Events"
APP_ENV=production
# Generate locally with `php artisan key:generate --show` and paste the
# result here ONCE. Never regenerate on redeploy — that invalidates every
# existing session/cookie/encrypted value. The Docker entrypoint refuses
# to boot if this is unset.
APP_KEY=
# Critical: debug mode leaks stack traces (including DB credentials in
# error pages) to visitors. Must be false in production.
APP_DEBUG=false
# The API's own public Railway/custom domain, e.g. https://api.yourdomain.com
APP_URL=

# config/database.php defaults to sqlite if this is unset.
DB_CONNECTION=mysql

# Railway's MySQL plugin exposes a full DSN var (commonly MYSQL_URL) once
# added to this project — reference it here with Railway's variable
# syntax so it stays in sync automatically:
#   DB_URL=${{MySQL.MYSQL_URL}}
# (exact source variable name depends on what the MySQL plugin exposes —
# check its Variables tab and reference whichever one is the full DSN).
# config/database.php already reads DB_URL and takes priority over the
# individual DB_HOST/DB_PORT/etc vars below, so those can stay unset.
DB_URL=

# Matches the local setup exactly — there are no migrations for the
# `cache`/`sessions`/`jobs` tables the `database` driver default expects,
# so these three MUST be file/file/sync or the app throws "table doesn't
# exist" on first request. Note: file-based sessions live on the
# container's local disk, which Railway wipes on every redeploy/restart
# (everyone gets logged out) — acceptable for a single-instance launch,
# revisit with a Redis plugin later if that becomes annoying.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Send logs to stderr so they show up in Railway's log viewer, instead of
# storage/logs/laravel.log which lives on ephemeral container disk and is
# lost on every redeploy.
LOG_CHANNEL=stderr

MAIL_MAILER=log

# Comma-separated frontend origins allowed to call the API from a browser
# (config/cors.php). Unset = '*' (local dev only).
CORS_ALLOWED_ORIGINS=

# Comma-separated frontend domains allowed to authenticate via Sanctum
# cookies, e.g. business.yourdomain.com,yourdomain.com,admin.yourdomain.com
SANCTUM_STATEFUL_DOMAINS=

# Real production URLs for the Customer/Business apps once they're
# deployed (Phase 5) — used for the cross-app "switch mode" redirects.
EVENT_FRONTEND_URL=
HOST_FRONTEND_URL=

# Stripe — leave blank until Phase 6 (payments/maps, deliberately last);
# checkout shows a graceful error until these are set, nothing crashes.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
