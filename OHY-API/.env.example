APP_NAME="OHY Events"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ohy_local
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Sanctum: comma-separated list of frontend domains allowed to authenticate
# via cookies (e.g. business.yourdomain.com,yourdomain.com,admin.yourdomain.com)
SANCTUM_STATEFUL_DOMAINS=

# URLs the 3 frontends live at — used for cross-app redirects
# (Customer <-> Business "switch mode" toggle, etc.)
EVENT_FRONTEND_URL=
HOST_FRONTEND_URL=

# Stripe — leave blank locally; checkout shows a graceful error until set
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
